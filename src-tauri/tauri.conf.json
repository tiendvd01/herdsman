{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Herdsman",
  "version": "0.1.0",
  "identifier": "app.herdsman",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node scripts/prepare-macos-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Herdsman",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 30
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "MacOS/herdsman-node": "target/installer-runtime/bin/node",
        "Resources/codex": "target/installer-codex",
        "Resources/Codex-LICENSE": "../scripts/Codex-LICENSE",
        "Resources/node-LICENSE": "target/installer-runtime/LICENSE",
        "Resources/sidecar/node_modules": "target/installer-sidecar/node_modules"
      }
    },
    "resources": {
      "../sidecar/src/": "sidecar/src/",
      "../sidecar/package.json": "sidecar/package.json"
    }
  }
}
